# Copy to .env and fill in. Never commit .env.
# All backend settings are read by receipt_shared.config.Settings.

# --- General ---
ENVIRONMENT=local            # local | dev | prod
LOG_LEVEL=INFO

# --- Google Cloud ---
GCP_PROJECT_ID=              # your GCP project ID (required for any cloud call)
GCP_REGION=us-central1

# --- Cloud Storage ---
GCS_UPLOAD_BUCKET=           # private bucket for uploaded documents
SIGNED_URL_TTL_SECONDS=900
SIGNING_SERVICE_ACCOUNT=        # e.g. receipt-api@PROJECT.iam.gserviceaccount.com
MAX_UPLOAD_BYTES=15728640    # 15 MiB (Gemini inline request limit is ~20 MB incl. base64)
MAX_PDF_PAGES=10
MAX_IMAGE_PIXELS=40000000

# --- Firestore ---
FIRESTORE_DATABASE=(default)
FIRESTORE_DOCUMENTS_COLLECTION=documents

# --- BigQuery ---
BIGQUERY_DATASET=receipt_analytics
BIGQUERY_LOCATION=US

# --- Gemini via Vertex AI ---
GEMINI_MODEL=gemini-3.8-flash   # any Gemini model your project can use in GEMINI_LOCATION
GEMINI_LOCATION=global           # Gemini 3.x models are served from "global"
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=4             # retries after the first attempt
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1.0
GEMINI_RETRY_MAX_DELAY_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=8192
# GEMINI_THINKING_BUDGET=0       # optional; unset = model default

# --- Validation ---
MONEY_TOLERANCE=0.02             # subtotal - discount + tax vs. total
LINE_ITEM_TOLERANCE=0.05         # sum of line items vs. subtotal/total
FUTURE_DATE_TOLERANCE_DAYS=1
MAX_DOCUMENT_AGE_DAYS=3650
MAX_REASONABLE_AMOUNT=1000000
SUPPORTED_CURRENCIES=USD,CAD,EUR,GBP,AUD,INR,JPY,CHF,MXN,NZD,SGD

# --- Auth (Firebase) ---
FIREBASE_PROJECT_ID=         # usually equal to GCP_PROJECT_ID
# Set to use the local Firebase Auth emulator instead of real Firebase:
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- API ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite; must be prefixed VITE_) ---
VITE_API_BASE_URL=           # empty = same origin (dev proxy forwards /api to the API)
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
