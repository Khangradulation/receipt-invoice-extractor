{
  "documents": {
    "description": "One row per processed document (all outcomes), for operational analytics.",
    "partition": {
      "field": "created_at",
      "type": "DAY"
    },
    "clustering": [
      "user_id",
      "processing_status"
    ],
    "schema": [
      {
        "name": "document_id",
        "type": "STRING",
        "mode": "REQUIRED",
        "description": ""
      },
      {
        "name": "user_id",
        "type": "STRING",
        "mode": "REQUIRED",
        "description": ""
      },
      {
        "name": "document_type",
        "type": "STRING",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "processing_status",
        "type": "STRING",
        "mode": "REQUIRED",
        "description": "Current status (VALID, REVIEW_REQUIRED, ...)"
      },
      {
        "name": "validation_status",
        "type": "STRING",
        "mode": "NULLABLE",
        "description": "Latest validation outcome"
      },
      {
        "name": "review_required",
        "type": "BOOL",
        "mode": "NULLABLE",
        "description": "Initial validation sent it to review"
      },
      {
        "name": "duplicate_status",
        "type": "STRING",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "error_count",
        "type": "INT64",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "warning_count",
        "type": "INT64",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "failed_fields",
        "type": "STRING",
        "mode": "REPEATED",
        "description": ""
      },
      {
        "name": "error_code",
        "type": "STRING",
        "mode": "NULLABLE",
        "description": "Processing error code if FAILED"
      },
      {
        "name": "content_type",
        "type": "STRING",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "size_bytes",
        "type": "INT64",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "page_count",
        "type": "INT64",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "model_version",
        "type": "STRING",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "prompt_version",
        "type": "STRING",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "rules_version",
        "type": "STRING",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "processing_attempts",
        "type": "INT64",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "processing_duration_ms",
        "type": "FLOAT64",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "created_at",
        "type": "TIMESTAMP",
        "mode": "REQUIRED",
        "description": ""
      },
      {
        "name": "uploaded_at",
        "type": "TIMESTAMP",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "completed_at",
        "type": "TIMESTAMP",
        "mode": "NULLABLE",
        "description": ""
      },
      {
        "name": "loaded_at",
        "type": "TIMESTAMP",
        "mode": "REQUIRED",
        "description": ""
      }
    ]
  },
